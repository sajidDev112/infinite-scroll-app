# Story API used by the desktop app (baked in at build time).
# An installed app can override it with %APPDATA%\Storyframe\config.json → { "apiUrl": "..." }
VITE_API_URL=http://localhost:4000/api

# Link used by the Share / Facebook / X buttons on each story ({id} = story id).
# Defaults to https://map-india.org/ until story pages are published online.
# VITE_SHARE_URL=https://your-site.example/stories/{id}
# An installed app can also set "shareUrl" in %APPDATA%\Storyframe\config.json

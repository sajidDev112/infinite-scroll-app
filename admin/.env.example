# Optional. Leave unset in development: the dashboard calls /api and Vite forwards it
# to http://localhost:4000, which also works from other devices on your network.
# Set it only when the built dashboard is hosted separately from the API:
# VITE_API_URL=https://api.example.com/api

# Link used by the share buttons in Preview ({id} = story id). Defaults to https://map-india.org/
# VITE_SHARE_URL=https://your-site.example/stories/{id}

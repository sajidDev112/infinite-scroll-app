# Copy to server/.env and fill in. Never commit .env.

NODE_ENV=development
API_PORT=4000

# Long random string (≥ 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Origins allowed to call the admin API (the admin dashboard URL).
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=15

# Admin created automatically on server start if this email has no account yet.
# (An existing account is left unchanged.) Password: at least 8 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- MongoDB: admins, stories, published stories, settings, fonts (and images when S3 is not set)
# Local:  mongodb://127.0.0.1:27017/infinite_scroll_app
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/infinite_scroll_app
MONGODB_URI=mongodb://127.0.0.1:27017/infinite_scroll_app

# Public address of this API, used for image links sent to the desktop app when behind a proxy.
# PUBLIC_URL=https://api.example.com

# --- AWS S3: story images (one folder per story). Leave empty to keep images in MongoDB.
# The IAM user needs s3:PutObject/GetObject/DeleteObject on the bucket and ListBucket.
# After adding these, move existing images:  npm run images:check  then  npm run images:to-s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Project folder inside the bucket.
S3_ROOT_FOLDER=infinite-scroll-app
# Optional: serve images through a CDN (e.g. CloudFront) instead of the bucket address.
# S3_PUBLIC_URL=https://dxxxxxxxx.cloudfront.net

# Copy to server/.env and fill in. Never commit .env or the service-account JSON.

NODE_ENV=development
API_PORT=4000

# Long random string (≥ 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Origins allowed to call the admin API (the admin dashboard URL).
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=15

# Admin created automatically on server start if this email has no account yet.
# (An existing account is left unchanged.) Password: at least 8 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Firebase (Firebase console → Project settings → Service accounts → Generate new private key)
# Option A: path to the downloaded JSON file (relative to server/)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Option B: inline values instead of the file
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Images
# local    → saved in server/uploads and served by this server at /uploads (no Firebase Storage needed)
# firebase → Firebase Storage (needs the Blaze plan); then set FIREBASE_STORAGE_BUCKET
STORAGE_DRIVER=local
# UPLOADS_DIR=uploads
# Public address of this API, used for image links sent to the desktop app when behind a proxy.
# PUBLIC_URL=https://api.example.com
FIREBASE_STORAGE_BUCKET=

{
  "name": "story-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test test/*.test.js",
    "images:check": "node --env-file-if-exists=.env scripts/images-to-s3.js --check",
    "images:to-s3": "node --env-file-if-exists=.env scripts/images-to-s3.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}

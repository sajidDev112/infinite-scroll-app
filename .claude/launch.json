        "--prefix",
        "admin",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
